# PII Firewall for AI Agents — Environment Configuration
# Copy this file to .env and update values for your environment.
# Never commit .env with real secrets to version control.

# === AI PII Detection (Google Gemini) ===
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === Backend Configuration ===
# Port for FastAPI backend (default: 8000)
BACKEND_PORT=8000

# CORS origins allowed to access the backend (comma-separated, * allows all)
CORS_ORIGINS=*

# Token vault TTL in seconds for stored PII tokens (default: 300 = 5 minutes)
TOKEN_VAULT_TTL_SECONDS=300

# Maximum number of in-memory audit log entries before oldest is evicted
AUDIT_LOG_MAX_ENTRIES=500

# Path to the SQLite database for persistent audit records
DATABASE_PATH=data/firewall_audit.db

# Path to the tool policy configuration file
POLICIES_PATH=data/synthetic_tool_policies.json

# === Security Settings ===
# Secret key for any future signed token extensions (placeholder only)
APP_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY

# Minimum PII detection confidence threshold (0.0 to 1.0)
DETECTION_CONFIDENCE_THRESHOLD=0.5

# === Evaluation Settings ===
# Random seed for reproducible synthetic test data generation
RANDOM_SEED=42

# Max synthetic test cases to run in one evaluation pass
EVALUATION_MAX_CASES=100

# === Frontend Configuration ===
# Backend API base URL used by the frontend (set in Vite dev proxy or .env.local)
VITE_API_BASE=http://localhost:8000/api
